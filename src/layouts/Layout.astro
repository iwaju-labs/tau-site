---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	pubDate?: string;
	type?: string;
	author?: string;
	keywords?: string[];
	jsonLdSchema?: 'website' | 'software';
	faqItems?: { q: string; a: string }[];
	noindex?: boolean;
}

const {
	title = 'Tau — Timelapse Recorder & Editor',
	description = 'A timelapse recorder and editor for macOS and Windows. Record your screen, camera, or both at once — with overlays, filters, and smooth editing tools.',
	ogImage = '/tau-assets/tau-twitter-image.jpg',
	pubDate,
	type = 'website',
	author,
	keywords,
	jsonLdSchema = 'website',
	faqItems,
	noindex = false,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImageAbsolute = new URL(ogImage, Astro.site).toString();

const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbItems = [
	{ name: 'Home', url: 'https://trytau.app/' },
	...pathSegments.map((segment, i) => ({
		name: segment === 'blog' ? 'Blog' : (i === pathSegments.length - 1 && type === 'article' ? title : segment.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())),
		url: `https://trytau.app/${pathSegments.slice(0, i + 1).join('/')}/`,
	})),
];
const breadcrumbSchema = pathSegments.length > 0 ? {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: breadcrumbItems.map((item, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: item.name,
		item: item.url,
	})),
} : null;

const jsonLd = type === 'article'
	? {
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: title,
		description,
		image: ogImageAbsolute,
		url: canonicalURL.toString(),
		...(pubDate && { datePublished: pubDate }),
		...(author && { author: { '@type': 'Person', name: author } }),
		publisher: {
			'@type': 'Organization',
			name: 'Tau',
			url: 'https://trytau.app',
		},
	}
	: jsonLdSchema === 'software'
	? {
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Tau',
		applicationCategory: 'MultimediaApplication',
		operatingSystem: 'macOS, Windows',
		description,
		url: 'https://trytau.app',
		offers: [
			{ '@type': 'Offer', price: '19', priceCurrency: 'USD', name: 'Solo' },
			{ '@type': 'Offer', price: '29', priceCurrency: 'USD', name: 'Pro' },
		],
	}
	: {
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Tau',
		url: 'https://trytau.app',
		description,
	};

const organizationLd = jsonLdSchema === 'software' ? {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Tau',
	url: 'https://trytau.app',
	logo: { '@type': 'ImageObject', url: 'https://trytau.app/tau-assets/tau-logo.png' },
	sameAs: ['https://twitter.com/_dngi'],
} : null;

const faqLd = faqItems && faqItems.length > 0 ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map(item => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
} : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/tau-assets/tau-logo.png" />
		<!-- Fonts: preconnect then load async to avoid render blocking -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" onload="this.rel='stylesheet'" />
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" /></noscript>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
		<title>{title}</title>
		<!-- Canonical -->
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<!-- RSS -->
		<link rel="alternate" type="application/rss+xml" title="Tau Blog" href="/rss.xml" />
		<!-- OG & Twitter -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Tau" />
		{pubDate && <meta property="article:published_time" content={pubDate} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageAbsolute} />
		<!-- JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		{organizationLd && <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />}
		{faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
		{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
		<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="8bcfcf1e-3021-4d02-9b43-6a7534e4b9d7"></script>
	</head>
	<body class="text-[#1a0f0d] antialiased">
		<slot />
	</body>
</html>
