---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	pubDate?: string;
	type?: string;
}

const {
	title = 'Tau — Timelapse Recorder & Editor',
	description = 'A timelapse recorder and editor for macOS and Windows. Create aesthetic timelapses with customizable overlays, filters, and smooth editing tools.',
	ogImage = '/tau-assets/tau-twitter-image.png',
	pubDate,
	type = 'website',
} = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/tau-assets/tau-logo.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<!-- OG & Twitter -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:type" content={type} />
		{pubDate && <meta property="article:published_time" content={pubDate} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script defer src="https://cloud.umami.is/script.js" data-website-id="8bcfcf1e-3021-4d02-9b43-6a7534e4b9d7"></script>
	</head>
	<body class="bg-zinc-950 text-zinc-100 antialiased">
		<slot />
	</body>
</html>
