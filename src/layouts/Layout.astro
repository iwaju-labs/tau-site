---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	pubDate?: string;
	type?: string;
	author?: string;
}

const {
	title = 'Tau — Timelapse Recorder & Editor',
	description = 'A timelapse recorder and editor for macOS and Windows. Create aesthetic timelapses with customizable overlays, filters, and smooth editing tools.',
	ogImage = '/tau-assets/tau-twitter-image.png',
	pubDate,
	type = 'website',
	author,
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageAbsolute = new URL(ogImage, Astro.site).toString();

const jsonLd = type === 'article'
	? {
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: title,
		description,
		image: ogImageAbsolute,
		url: canonicalURL.toString(),
		...(pubDate && { datePublished: pubDate }),
		...(author && { author: { '@type': 'Person', name: author } }),
		publisher: {
			'@type': 'Organization',
			name: 'Tau',
			url: 'https://trytau.app',
		},
	}
	: {
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: 'Tau',
		url: 'https://trytau.app',
		description,
	};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/tau-assets/tau-logo.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<!-- Canonical -->
		<link rel="canonical" href={canonicalURL} />
		<!-- RSS -->
		<link rel="alternate" type="application/rss+xml" title="Tau Blog" href="/rss.xml" />
		<!-- OG & Twitter -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Tau" />
		{pubDate && <meta property="article:published_time" content={pubDate} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageAbsolute} />
		<!-- JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="8bcfcf1e-3021-4d02-9b43-6a7534e4b9d7"></script>
	</head>
	<body class="bg-zinc-950 text-zinc-100 antialiased">
		<slot />
	</body>
</html>
