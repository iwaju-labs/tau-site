---
const tiers = [
	{
		name: 'Solo',
		price: '$19',
		description: 'Best for personal use',
		activations: '1 device',
		cta: 'Buy Solo',
		href: '#', // Replace with Lemon Squeezy checkout URL
		highlight: false,
	},
	{
		name: 'Pro',
		price: '$39',
		description: 'Best for creators with multiple machines',
		activations: 'Up to 3 devices',
		cta: 'Buy Pro',
		href: '#', // Replace with Lemon Squeezy checkout URL
		highlight: true,
	},
];
---

<section id="pricing" class="py-24 px-6">
	<div class="mx-auto max-w-3xl text-center">
		<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
			Simple, one-time pricing.
		</h2>
		<p class="mt-4 text-zinc-400">Pay once. Own it forever. Free updates included.</p>
	</div>
	<div class="mx-auto mt-16 grid max-w-3xl gap-8 sm:grid-cols-2">
		{tiers.map((tier) => (
			<div class={`border p-8 flex flex-col ${tier.highlight ? 'border-white bg-white text-zinc-900' : 'border-zinc-800 bg-zinc-900 text-white'}`}>
				<h3 class="text-lg font-semibold">{tier.name}</h3>
				<p class={`mt-1 text-sm ${tier.highlight ? 'text-zinc-600' : 'text-zinc-400'}`}>{tier.description}</p>
				<div class="mt-6 text-5xl font-bold">{tier.price}</div>
				<p class={`mt-2 text-sm ${tier.highlight ? 'text-zinc-600' : 'text-zinc-400'}`}>{tier.activations}</p>
				<a
					href={tier.href}
					class={`mt-8 py-3 text-center text-sm font-semibold transition ${tier.highlight ? 'bg-zinc-900 text-white hover:bg-zinc-700' : 'bg-white text-zinc-900 hover:bg-zinc-200'}`}
				>
					{tier.cta}
				</a>
			</div>
		))}
	</div>
</section>
