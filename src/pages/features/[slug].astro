---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer';
import FeatureIcon from '../../components/FeatureIcon';
import { features } from '../../data/features';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
	return features.map((feature) => ({
		params: { slug: feature.slug },
	}));
}

const { slug } = Astro.params;
const feature = features.find((f) => f.slug === slug)!;
const otherFeatures = features.filter((f) => f.slug !== slug);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
	.filter((p) => p.data.tags?.some((t) => feature.tags.includes(t)))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.slice(0, 3);
---

<Layout
	title={`${feature.title} — Tau`}
	description={feature.description}
>
	<main class="mx-auto max-w-3xl px-6 pt-32 pb-24">

		<!-- Breadcrumb -->
		<nav class="mb-10 flex items-center gap-2 text-sm text-[#9b8880]">
			<a href="/" class="hover:text-[#aa1e0f] transition">Home</a>
			<span>/</span>
			<a href="/features" class="hover:text-[#aa1e0f] transition">Features</a>
			<span>/</span>
			<span class="text-[#1a0f0d]">{feature.title}</span>
		</nav>

		<!-- Hero -->
		<div class="flex items-center gap-4">
			<FeatureIcon slug={slug} className="size-8 text-[#6b4f47]" />
			<h1 class="text-3xl font-bold tracking-tight text-[#1a0f0d] sm:text-4xl">{feature.title}</h1>
		</div>
		<p class="mt-6 text-lg text-[#6b4f47] leading-relaxed">{feature.overview}</p>

		<!-- Benefits -->
		<section class="mt-16">
			<h2 class="text-2xl font-semibold text-[#1a0f0d]">Benefits</h2>
			<ul class="mt-8 space-y-6">
				{feature.benefits.map((benefit) => (
					<li class="border-l-2 border-[#aa1e0f] pl-6">
						<h3 class="font-semibold text-[#1a0f0d]">{benefit.title}</h3>
						<p class="mt-1 text-sm text-[#6b4f47] leading-relaxed">{benefit.description}</p>
					</li>
				))}
			</ul>
		</section>

		<!-- How to use -->
		<section class="mt-16">
			<h2 class="text-2xl font-semibold text-[#1a0f0d]">How to use</h2>
			<ol class="mt-8 space-y-6">
				{feature.howToUse.map((step, i) => (
					<li class="flex gap-5">
						<span class="flex size-7 shrink-0 items-center justify-center border border-[#cfc4ba] text-sm font-semibold text-[#6b4f47]">
							{i + 1}
						</span>
						<div>
							<h3 class="font-semibold text-[#1a0f0d]">{step.title}</h3>
							<p class="mt-1 text-sm text-[#6b4f47] leading-relaxed">{step.description}</p>
						</div>
					</li>
				))}
			</ol>
		</section>

		<!-- FAQ -->
		<section class="mt-16">
			<h2 class="text-2xl font-semibold text-[#1a0f0d]">FAQ</h2>
			<dl class="mt-8 space-y-8">
				{feature.faq.map((item) => (
					<div>
						<dt class="font-semibold text-[#1a0f0d]">{item.question}</dt>
						<dd class="mt-2 text-sm text-[#6b4f47] leading-relaxed">{item.answer}</dd>
					</div>
				))}
			</dl>
		</section>

		<!-- Related blog posts -->
		{relatedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="text-2xl font-semibold text-[#1a0f0d]">From the blog</h2>
				<ul class="mt-6 grid gap-4 sm:grid-cols-3">
					{relatedPosts.map((p) => (
						<li>
							<a
								href={`/blog/${p.id}`}
								class="flex flex-col gap-2 border border-[#cfc4ba] bg-[#e0d8cf] p-4 hover:border-[#aa1e0f] transition"
							>
								<span class="text-sm font-medium text-[#1a0f0d] leading-snug">{p.data.title}</span>
								<span class="text-xs text-[#6b4f47] leading-relaxed line-clamp-2">{p.data.description}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		<!-- Other features -->
		<section class="mt-20 border-t border-[#cfc4ba] pt-12">
			<h2 class="text-lg font-semibold text-[#1a0f0d]">Explore other features</h2>
			<ul class="mt-6 grid gap-4 sm:grid-cols-3">
				{otherFeatures.map((f) => (
					<li>
						<a
							href={`/features/${f.slug}`}
							class="flex flex-col gap-2 border border-[#cfc4ba] bg-[#e0d8cf] p-4 hover:border-[#aa1e0f] transition"
						>
							<span class="text-sm font-medium text-[#1a0f0d]">{f.title}</span>
							<span class="text-xs text-[#6b4f47] leading-relaxed line-clamp-2">{f.description}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

	</main>
	<Footer />
</Layout>
