---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer';
import Navbar from '../../components/Navbar';
import FeatureCards from '../../components/FeatureCards';
---

<Layout
	title="Features — Tau"
	description="Explore every feature in Tau: screen recording, camera recording, multi-source capture, timer overlays, a minimal editor, and multi-format export."
>
	<Navbar client:load />
	<main class="mx-auto max-w-5xl px-6 pt-32 pb-24">
		<h1 class="text-4xl font-bold tracking-tight text-[#1a0f0d] sm:text-5xl">Features</h1>
		<p class="mt-4 text-lg text-[#6b4f47] max-w-2xl">
			Everything Tau can do — from recording your first timelapse to exporting it exactly how you want.
		</p>
		<FeatureCards />
	</main>
	<Footer />
</Layout>
