---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import Hero from '../components/Hero.tsx';
import DemoSection from '../components/DemoSection.tsx';
import ComparisonSection from '../components/ComparisonSection.tsx';
import WhyTau from '../components/WhyTau.tsx';
import Testimonials from '../components/Testimonials.tsx';
import Features from '../components/Features.tsx';
import Pricing from '../components/Pricing.tsx';
import FAQ from '../components/FAQ.tsx';
import Footer from '../components/Footer.tsx';
import { faqs } from '../data/faqs';
import { getPricingTier } from '../lib/redis';
import PromoBanner from '../components/PromoBanner.tsx';

const { solo, spotsLeft, tierIndex } = await getPricingTier();

const TIER_NEXT_PRICES: Record<number, { solo: string; pro: string } | null> = {
	1: { solo: '€18.99', pro: '€40.99' },
	2: { solo: '€24.99', pro: '€50.99' },
	3: null,
};
const nextPrice = TIER_NEXT_PRICES[tierIndex]?.solo ?? null;

const keywords = [
	// Core product
	'timelapse app', 'timelapse software', 'timelapse recorder', 'timelapse editor',
	'timelapse recording software', 'timelapse recording app', 'timelapse creator', 'timelapse maker',
	// Platform-specific (high intent)
	'timelapse app for mac', 'timelapse app for windows', 'best timelapse app',
	'how to record timelapse on mac', 'how to make a timelapse on mac',
	// High-volume trending (from search data)
	'video timelapse', 'timelapse video', 'timelapse camera', 'camera timelapse',
	'construction timelapse', 'timelapse photography', 'ai timelapse',
	// Long-tail / feature-specific
	'timelapse with overlays', 'screen timelapse', 'timelapse for windows',
];
---

<Layout
	title="Tau — Timelapse Recorder & Editor for Mac & Windows"
	description="Create stunning timelapses on macOS and Windows. Record, edit, and export with customizable overlays, filters, and smooth editing tools. Download free today."
	keywords={keywords}
	jsonLdSchema="software"
	faqItems={faqs}
>
	<PromoBanner currentPrice={solo} nextPrice={nextPrice} spotsLeft={spotsLeft} />
	<Navbar />
	<Hero spotsLeft={spotsLeft} nextPrice={nextPrice} />
	<DemoSection client:load />
	<WhyTau />
	<Features />
	<ComparisonSection client:load />
	<Testimonials client:load />
	<Pricing client:load />
	<FAQ />
	<Footer />
</Layout>
