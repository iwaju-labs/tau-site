---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.tsx';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;

const TITLE_KEYWORDS = ["timelapse", "timelapse video", "video timelapse", "iphone timelapse", "tutorial", "mac", "tau", "record", "productivity", "camera"];
const DEFAULT_TAGS = ["tau"];

function getEffectiveTags(p: typeof post): string[] {
  const existing = (p.data.tags ?? []).map((t) => t.toLowerCase());
  const fromTitle = TITLE_KEYWORDS.filter((kw) => p.data.title.toLowerCase().includes(kw));
  return Array.from(new Set([...DEFAULT_TAGS, ...existing, ...fromTitle]));
}

const currentTags = getEffectiveTags(post);
const otherPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const tagMatches = otherPosts.filter((p) =>
  getEffectiveTags(p).some((t) => currentTags.includes(t))
);

const relatedPosts = (tagMatches.length > 0 ? tagMatches : otherPosts).slice(0, 3);
const { Content } = await render(post);

const words = (post.body ?? '').trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.round(words / 200));

// HowTo schema for "how to" posts — extract H2 headings as steps
const isHowTo = post.data.title.toLowerCase().startsWith('how to');
const h2Headings = [...(post.body ?? '').matchAll(/^##\s+(.+)$/gm)].map(m => m[1].trim());
const howToLd = isHowTo && h2Headings.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: post.data.title,
  description: post.data.description,
  step: h2Headings.map((name, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name,
    url: `https://trytau.app/blog/${post.id}#${name.toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-')}`,
  })),
} : null;
---

<Layout
  title={`${post.data.title} - Tau Blog`}
  description={post.data.description}
  ogImage={`/api/og?title=${encodeURIComponent(post.data.title)}`}
  pubDate={post.data.pubDate.toISOString()}
  type="article"
  author={post.data.author}
>
  {howToLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(howToLd)} />}

  <main class="pt-32 pb-24 px-6 min-h-screen">
    <div class="mx-auto max-w-3xl xl:max-w-6xl xl:flex xl:gap-12">
      <!-- TOC: sticky sidebar, only visible on xl+ -->
      <nav id="toc" class="sticky top-36 hidden xl:flex flex-col gap-1 w-52 shrink-0 self-start">
        <p class="text-xs font-semibold text-[#9b8880] uppercase tracking-widest mb-2">On this page</p>
        <ul id="toc-list" class="space-y-0.5 text-sm border-l border-[#cfc4ba] pl-3"></ul>
      </nav>
      <div class="max-w-3xl w-full">
      <a href="/blog" class="text-sm text-[#6b4f47] hover:text-[#aa1e0f] transition-colors mb-10 inline-block">
        ← Back to blog
      </a>

      <div class="flex items-center gap-3 text-sm text-[#9b8880] mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {post.data.author && (
          <>
            <span>·</span>
            <span class="flex items-center gap-1 hover:text-[#aa1e0f] transition">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
              <a href="https://twitter.com/_dngi">
                {post.data.author}
              </a>
            </span>
          </>
        )}
        <span>·</span>
        <span>{readingTime} min read</span>
      </div>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex gap-2 mb-8 flex-wrap">
          {post.data.tags.map((tag) => (
            <span class="text-xs text-[#6b4f47] bg-[#e0d8cf] border border-[#cfc4ba] px-2.5 py-1 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}

      <div class="markdown-content -my-2">
        <h1>{post.data.title}</h1>
      </div>

      <!-- Inline TOC: only visible below xl -->
      <nav id="toc-inline" class="xl:hidden mb-8 border border-[#cfc4ba] rounded-lg px-5 py-4 hidden">
        <p class="text-xs font-semibold text-[#9b8880] uppercase tracking-widest mb-3">On this page</p>
        <ul id="toc-inline-list" class="space-y-1 text-sm border-l border-[#cfc4ba] pl-3"></ul>
      </nav>

      <article class="markdown-content max-w-none">
        <p>
          {post.data.description}
        </p>
        <Content />
      </article>

      {otherPosts.length > 0 && (
        <aside class="mt-20 border-t border-[#cfc4ba] pt-12">
          <h2 class="text-lg font-semibold text-[#1a0f0d]">Related posts</h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-3">
            {relatedPosts.map((p) => (
              <li>
                <a
                  href={`/blog/${p.id}`}
                  class="group flex flex-col rounded-2xl border border-[#cfc4ba] bg-[#e0d8cf] overflow-hidden hover:border-[#aa1e0f] transition-colors p-4 gap-1.5"
                >
                  <span class="text-sm font-semibold text-[#1a0f0d] leading-snug group-hover:text-[#aa1e0f] transition-colors">{p.data.title}</span>
                  <span class="text-xs text-[#6b4f47] leading-relaxed line-clamp-2">{p.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const headings = Array.from(
    document.querySelectorAll<HTMLHeadingElement>('.markdown-content h2, .markdown-content h3')
  );
  const toc = document.getElementById('toc');
  const tocList = document.getElementById('toc-list');
  const tocInline = document.getElementById('toc-inline');
  const tocInlineList = document.getElementById('toc-inline-list');

  if (headings.length < 2) {
    toc?.remove();
    tocInline?.remove();
  } else {
    headings.forEach((h) => {
      if (!h.id) {
        h.id = h.textContent!
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-');
      }

      const linkClass =
        h.tagName === 'H3'
          ? 'block pl-3 text-[#9b8880] hover:text-[#aa1e0f] transition-colors py-0.5 leading-snug'
          : 'block text-[#6b4f47] hover:text-[#aa1e0f] transition-colors py-0.5 leading-snug';

      for (const list of [tocList, tocInlineList]) {
        if (!list) continue;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent;
        a.dataset.tocId = h.id;
        a.className = linkClass;
        li.appendChild(a);
        list.appendChild(li);
      }
    });

    tocInline?.classList.remove('hidden');

    const allLinks = document.querySelectorAll<HTMLAnchorElement>('a[data-toc-id]');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          allLinks.forEach((l) => l.classList.remove('!text-[#aa1e0f]'));
          document.querySelectorAll<HTMLAnchorElement>(`a[data-toc-id="${entry.target.id}"]`)
            .forEach((l) => l.classList.add('!text-[#aa1e0f]'));
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>
