---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;

const TITLE_KEYWORDS = ["timelapse", "tutorial", "mac", "tau", "record", "productivity", "camera"];
const DEFAULT_TAGS = ["tau"];

function getEffectiveTags(p: typeof post): string[] {
  const existing = (p.data.tags ?? []).map((t) => t.toLowerCase());
  const fromTitle = TITLE_KEYWORDS.filter((kw) => p.data.title.toLowerCase().includes(kw));
  return Array.from(new Set([...DEFAULT_TAGS, ...existing, ...fromTitle]));
}

const currentTags = getEffectiveTags(post);
const otherPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const tagMatches = otherPosts.filter((p) =>
  getEffectiveTags(p).some((t) => currentTags.includes(t))
);

const relatedPosts = (tagMatches.length > 0 ? tagMatches : otherPosts).slice(0, 3);
const { Content } = await render(post);

const words = (post.body ?? '').trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.round(words / 200));
---

<Layout
  title={`${post.data.title} - Tau Blog`}
  description={post.data.description}
  ogImage={post.data.heroImage}
  pubDate={post.data.pubDate.toISOString()}
  type="article"
  author={post.data.author}
>
  <Navbar client:load />

  <!-- TOC: fixed sidebar, only visible on xl+ when there's room beside max-w-3xl -->
  <nav id="toc" class="fixed top-36 hidden xl:flex flex-col gap-1 w-52" style="left: max(1.5rem, calc(50% - 26rem - 13.5rem))">
    <p class="text-xs font-semibold text-zinc-500 uppercase tracking-widest mb-2">On this page</p>
    <ul id="toc-list" class="space-y-0.5 text-sm border-l border-zinc-800 pl-3"></ul>
  </nav>

  <main class="pt-32 pb-24 px-6 min-h-screen">
    <div class="mx-auto max-w-3xl">
      <a href="/blog" class="text-sm text-zinc-500 hover:text-zinc-300 transition-colors mb-10 inline-block">
        ← Back to blog
      </a>

      <div class="flex items-center gap-3 text-sm text-zinc-500 mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {post.data.author && (
          <>
            <span>·</span>
            <span class="flex items-center gap-1 hover:text-white transition">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
              <a href="https://twitter.com/_dngi">
                {post.data.author}
              </a>
            </span>
          </>
        )}
        <span>·</span>
        <span>{readingTime} min read</span>
      </div>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex gap-2 mb-8 flex-wrap">
          {post.data.tags.map((tag) => (
            <span class="text-xs text-zinc-500 bg-zinc-900 border border-zinc-800 px-2.5 py-1 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}

      <div class="markdown-content -my-2">
        <h1>{post.data.title}</h1>
      </div>

      <!-- Inline TOC: only visible below xl -->
      <nav id="toc-inline" class="xl:hidden mb-8 border border-zinc-800 rounded-lg px-5 py-4 hidden">
        <p class="text-xs font-semibold text-zinc-500 uppercase tracking-widest mb-3">On this page</p>
        <ul id="toc-inline-list" class="space-y-1 text-sm border-l border-zinc-800 pl-3"></ul>
      </nav>

      <article class="markdown-content max-w-none">
        <p>
          {post.data.description}
        </p>
        <Content />
      </article>

      {otherPosts.length > 0 && (
        <aside class="mt-20 border-t border-zinc-800 pt-12">
          <h2 class="text-lg font-semibold text-white">Related posts</h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-3">
            {relatedPosts.map((p) => (
              <li>
                <a
                  href={`/blog/${p.id}`}
                  class="group flex flex-col rounded-2xl border border-zinc-800 bg-zinc-900 overflow-hidden hover:border-zinc-600 transition-colors"
                >
                  <div class="aspect-video w-full bg-zinc-800 overflow-hidden">
                    {p.data.heroImage ? (
                      <img
                        src={p.data.heroImage}
                        alt={p.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-zinc-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 19.5h18M3.75 4.5h16.5A.75.75 0 0121 5.25v13.5a.75.75 0 01-.75.75H3.75A.75.75 0 013 18.75V5.25A.75.75 0 013.75 4.5z" />
                        </svg>
                      </div>
                    )}
                  </div>
                  <div class="flex flex-col gap-1.5 p-4">
                    <span class="text-sm font-semibold text-white leading-snug group-hover:text-zinc-200 transition-colors">{p.data.title}</span>
                    <span class="text-xs text-zinc-500 leading-relaxed line-clamp-2">{p.data.description}</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const headings = Array.from(
    document.querySelectorAll<HTMLHeadingElement>('.markdown-content h2, .markdown-content h3')
  );
  const toc = document.getElementById('toc');
  const tocList = document.getElementById('toc-list');
  const tocInline = document.getElementById('toc-inline');
  const tocInlineList = document.getElementById('toc-inline-list');

  if (headings.length < 2) {
    toc?.remove();
    tocInline?.remove();
  } else {
    // Assign IDs and populate both lists
    headings.forEach((h) => {
      if (!h.id) {
        h.id = h.textContent!
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-');
      }

      const linkClass =
        h.tagName === 'H3'
          ? 'block pl-3 text-zinc-600 hover:text-zinc-300 transition-colors py-0.5 leading-snug'
          : 'block text-zinc-500 hover:text-zinc-200 transition-colors py-0.5 leading-snug';

      for (const list of [tocList, tocInlineList]) {
        if (!list) continue;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent;
        a.dataset.tocId = h.id;
        a.className = linkClass;
        li.appendChild(a);
        list.appendChild(li);
      }
    });

    // Show inline TOC now that it's populated
    tocInline?.classList.remove('hidden');

    // Highlight active heading on scroll (both lists)
    const allLinks = document.querySelectorAll<HTMLAnchorElement>('a[data-toc-id]');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          allLinks.forEach((l) => l.classList.remove('!text-white'));
          document.querySelectorAll<HTMLAnchorElement>(`a[data-toc-id="${entry.target.id}"]`)
            .forEach((l) => l.classList.add('!text-white'));
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>
