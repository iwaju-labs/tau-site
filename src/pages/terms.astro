---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import Footer from '../components/Footer.tsx';
---

<Layout title="Terms of Service - Tau" description="Terms of Service for Tau.">
	<Navbar client:load />
	<main class="pt-32 pb-24 px-6 min-h-screen">
		<div class="mx-auto max-w-3xl">
			<h1 class="text-4xl font-bold tracking-tight text-white mb-8">Terms of Service</h1>
			
			<div class="prose prose-invert prose-zinc max-w-none">
				<p class="text-zinc-400 mb-8">Last updated: {new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>

				<h2 class="text-2xl font-semibold text-white mt-12 mb-4">1. Acceptance of Terms</h2>
				<p class="text-zinc-400 mb-6">
					By accessing and using the Tau application and website, you accept and agree to be bound by the terms and provision of this agreement.
				</p>

				<h2 class="text-2xl font-semibold text-white mt-12 mb-4">2. License Grant</h2>
				<p class="text-zinc-400 mb-6">
					Upon purchase, you are granted a non-exclusive, non-transferable license to use Tau according to your tier:
				</p>
				<ul class="list-disc pl-6 text-zinc-400 mb-6 space-y-2">
					<li><strong>Solo License:</strong> Valid for use on 1 device.</li>
					<li><strong>Pro License:</strong> Valid for use on up to 3 devices.</li>
				</ul>

				<h2 class="text-2xl font-semibold text-white mt-12 mb-4">3. Restrictions</h2>
				<p class="text-zinc-400 mb-6">
					You may not:
				</p>
				<ul class="list-disc pl-6 text-zinc-400 mb-6 space-y-2">
					<li>Modify, translate, reverse engineer, decompile, or disassemble the software.</li>
					<li>Rent, lease, lend, sell, redistribute, or sublicense the software.</li>
					<li>Share your license key with others.</li>
				</ul>

				<h2 class="text-2xl font-semibold text-white mt-12 mb-4">4. Refunds</h2>
				<p class="text-zinc-400 mb-6">
					We offer a 14-day money-back guarantee if the software does not meet your expectations. Contact support to request a refund.
				</p>

				<h2 class="text-2xl font-semibold text-white mt-12 mb-4">5. Contact</h2>
				<p class="text-zinc-400 mb-6">
					For any questions regarding these terms, please contact <a href="mailto:hello@usetau.app" class="text-white hover:underline">hello@usetau.app</a>.
				</p>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
