---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.tsx';
import Footer from '../components/Footer.tsx';
---

<Layout title="404: Not Found - Tau" description="The page you were looking for doesn't exist.">
	<Navbar client:load />
	<main class="pt-32 pb-24 px-6 min-h-[80vh] flex flex-col items-center justify-center text-center mt-12">
		<img 
			src="/tau-assets/tau-logo-transparent.png" 
			alt="Tau Logo" 
			class="w-64 h-64 mb-8 object-contain invert"
		/>
		<h1 class="text-4xl font-bold tracking-tight text-white mb-4">Page Not Found</h1>
		<p class="text-zinc-400 mb-8 max-w-md mx-auto text-lg">
			The page you were looking for doesn't exist. It might have been moved or deleted.
		</p>
		<a 
			href="/" 
			class="px-6 py-3 bg-white text-zinc-950 font-semibold rounded-lg hover:bg-zinc-200 transition"
		>
			Return to Home
		</a>
	</main>
	<Footer />
</Layout>