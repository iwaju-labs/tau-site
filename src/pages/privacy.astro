---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.tsx';
---

<Layout title="Privacy Policy - Tau" description="Privacy Policy for Tau." noindex={true}>
	<main class="pt-32 pb-24 px-6 min-h-screen">
		<div class="mx-auto max-w-3xl">
			<h1 class="text-4xl font-bold tracking-tight text-[#1a0f0d] mb-8">Privacy Policy</h1>

			<div class="max-w-none">
				<p class="text-[#6b4f47] mb-8">Last updated: {new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>

				<h2 class="text-2xl font-semibold text-[#1a0f0d] mt-12 mb-4">1. Introduction</h2>
				<p class="text-[#6b4f47] mb-6">
					Welcome to Tau. We respect your privacy and are committed to protecting your personal data. This privacy policy will inform you as to how we look after your personal data when you visit our website or use our application.
				</p>

				<h2 class="text-2xl font-semibold text-[#1a0f0d] mt-12 mb-4">2. Data We Collect</h2>
				<p class="text-[#6b4f47] mb-6">
					We only collect the information necessary to provide our services:
				</p>
				<ul class="list-disc pl-6 text-[#6b4f47] mb-6 space-y-2">
					<li><strong>Account Information:</strong> Email address when you purchase a license.</li>
					<li><strong>Payment Information:</strong> Processed securely by our payment provider (Polar). We do not store your credit card details.</li>
					<li><strong>Usage Data:</strong> Basic telemetry to improve the app (can be opted out).</li>
				</ul>

				<h2 class="text-2xl font-semibold text-[#1a0f0d] mt-12 mb-4">3. How We Use Your Data</h2>
				<p class="text-[#6b4f47] mb-6">
					We use your data to:
				</p>
				<ul class="list-disc pl-6 text-[#6b4f47] mb-6 space-y-2">
					<li>Process your payments and deliver license keys.</li>
					<li>Provide customer support.</li>
					<li>Send important updates about the app.</li>
				</ul>

				<h2 class="text-2xl font-semibold text-[#1a0f0d] mt-12 mb-4">4. Contact Us</h2>
				<p class="text-[#6b4f47] mb-6">
					If you have any questions about this privacy policy, please reach out on <a href="https://twitter.com/_dngi" class="text-[#aa1e0f] hover:underline" target="_blank" rel="noopener noreferrer">X (@_dngi)</a>.
				</p>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
