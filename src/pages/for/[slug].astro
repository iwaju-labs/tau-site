---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.tsx';
import { useCases } from '../../data/useCases';
import { features } from '../../data/features';

export const prerender = true;

export function getStaticPaths() {
	return useCases.map((u) => ({ params: { slug: u.slug } }));
}

const { slug } = Astro.params;
const u = useCases.find((uc) => uc.slug === slug)!;
const relatedFeatures = features.filter((f) => u.relatedFeatures.includes(f.slug));
---

<Layout
	title={u.metaTitle}
	description={u.metaDescription}
	keywords={['tau', u.audience, 'timelapse', u.slug.replace(/-/g, ' ')]}
	faqItems={u.faq.map((f) => ({ q: f.question, a: f.answer }))}
>
	<main class="pt-32 pb-24 px-6 min-h-screen">
		<div class="mx-auto max-w-3xl">

			<!-- Breadcrumb -->
			<nav class="mb-10 flex items-center gap-2 text-sm text-[#9b8880]">
				<a href="/" class="hover:text-[#aa1e0f] transition">Home</a>
				<span>/</span>
				<span class="text-[#1a0f0d]">{u.title}</span>
			</nav>

			<!-- Hero -->
			<h1 class="text-4xl font-bold tracking-tight text-[#1a0f0d] sm:text-5xl">{u.headline}</h1>
			<p class="mt-6 text-lg text-[#6b4f47] leading-relaxed max-w-2xl">{u.subheadline}</p>

			<div class="mt-8 flex flex-wrap gap-4">
				<a href="/pricing" class="bg-[#aa1e0f] px-8 py-3 text-sm font-bold text-[#ede6de] hover:bg-[#8a1800] transition">
					Get Tau — €25
				</a>
				<a href="/#demo" class="px-8 py-3 text-sm font-semibold text-[#6b4f47] border border-[#cfc4ba] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">
					See Tau in action ↓
				</a>
			</div>

			<!-- Pain points -->
			<section class="mt-20">
				<h2 class="text-2xl font-bold text-[#1a0f0d] mb-6">Sound familiar?</h2>
				<ul class="space-y-3">
					{u.painPoints.map((p) => (
						<li class="flex gap-3 text-[#6b4f47]">
							<span class="text-[#aa1e0f] mt-0.5 shrink-0">✗</span>
							{p}
						</li>
					))}
				</ul>
			</section>

			<!-- Benefits -->
			<section class="mt-16">
				<h2 class="text-2xl font-bold text-[#1a0f0d] mb-8">How Tau helps</h2>
				<ul class="space-y-6">
					{u.benefits.map((b) => (
						<li class="border-l-2 border-[#aa1e0f] pl-6">
							<h3 class="font-semibold text-[#1a0f0d]">{b.title}</h3>
							<p class="mt-1 text-sm text-[#6b4f47] leading-relaxed">{b.description}</p>
						</li>
					))}
				</ul>
			</section>

			<!-- FAQ -->
			<section class="mt-16">
				<h2 class="text-2xl font-bold text-[#1a0f0d] mb-8">FAQ</h2>
				<dl class="space-y-8">
					{u.faq.map((item) => (
						<div>
							<dt class="font-semibold text-[#1a0f0d]">{item.question}</dt>
							<dd class="mt-2 text-sm text-[#6b4f47] leading-relaxed">{item.answer}</dd>
						</div>
					))}
				</dl>
			</section>

			<!-- Related features -->
			{relatedFeatures.length > 0 && (
				<section class="mt-16">
					<h2 class="text-lg font-semibold text-[#1a0f0d] mb-6">Relevant features</h2>
					<ul class="grid gap-4 sm:grid-cols-3">
						{relatedFeatures.map((f) => (
							<li>
								<a
									href={`/features/${f.slug}`}
									class="flex flex-col gap-2 border border-[#cfc4ba] bg-[#e0d8cf] p-4 hover:border-[#aa1e0f] transition"
								>
									<span class="text-sm font-medium text-[#1a0f0d]">{f.title}</span>
									<span class="text-xs text-[#6b4f47] leading-relaxed line-clamp-2">{f.description}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<!-- Bottom CTA -->
			<section class="mt-20 border-t border-[#cfc4ba] pt-12 text-center">
				<h2 class="text-2xl font-bold text-[#1a0f0d]">Ready to make better timelapses?</h2>
				<p class="mt-3 text-[#6b4f47]">One-time payment. Free updates. macOS and Windows.</p>
				<a href="/pricing" class="mt-6 inline-block bg-[#aa1e0f] px-10 py-4 text-sm font-bold text-[#ede6de] hover:bg-[#8a1800] transition">
					Get Tau — €25
				</a>
			</section>

			<!-- Links to other use cases -->
			<section class="mt-16">
				<h3 class="text-sm font-semibold text-[#9b8880] uppercase tracking-widest mb-4">Other use cases</h3>
				<div class="flex flex-wrap gap-3">
					{useCases.filter((uc) => uc.slug !== u.slug).map((uc) => (
						<a
							href={`/for/${uc.slug}`}
							class="text-sm text-[#6b4f47] border border-[#cfc4ba] px-4 py-2 hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition"
						>
							{uc.title}
						</a>
					))}
				</div>
			</section>

		</div>
	</main>
	<Footer />
</Layout>
