---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.tsx';
import { competitors } from '../../data/competitors';
import { Check, X, Minus } from 'lucide-react';

export const prerender = true;

export function getStaticPaths() {
	return competitors.map((c) => ({ params: { slug: c.slug }, props: { competitor: c } }));
}

const { competitor: c } = Astro.props;
---

<Layout
	title={c.metaTitle}
	description={c.metaDescription}
	keywords={['tau', c.name.toLowerCase(), 'timelapse', 'comparison', 'vs', 'alternative']}
>
	<main class="pt-32 pb-24 px-6 min-h-screen">
		<div class="mx-auto max-w-3xl">

			<!-- Breadcrumb -->
			<nav class="mb-10 flex items-center gap-2 text-sm text-[#9b8880]">
				<a href="/" class="hover:text-[#aa1e0f] transition">Home</a>
				<span>/</span>
				<span class="text-[#1a0f0d]">Tau vs {c.name}</span>
			</nav>

			<!-- Hero -->
			<h1 class="text-4xl font-bold tracking-tight text-[#1a0f0d] sm:text-5xl">
				Tau vs {c.name}
			</h1>
			<p class="mt-4 text-[#9b8880] text-sm font-medium">{c.category} · {c.price}</p>
			<p class="mt-6 text-lg text-[#6b4f47] leading-relaxed max-w-2xl">{c.summary}</p>

			<!-- CTA -->
			<div class="mt-8 flex flex-wrap gap-4">
				<a href="/#pricing" class="bg-[#aa1e0f] px-8 py-3 text-sm font-bold text-[#ede6de] hover:bg-[#8a1800] transition">
					Get Tau — from €9.99
				</a>
				<a href="/#demo" class="px-8 py-3 text-sm font-semibold text-[#6b4f47] border border-[#cfc4ba] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">
					See Tau in action ↓
				</a>
			</div>

			<!-- Feature comparison table -->
			<section class="mt-20">
				<h2 class="text-2xl font-bold text-[#1a0f0d] mb-8">Feature comparison</h2>
				<div class="border border-[#cfc4ba] overflow-hidden">
					<table class="w-full text-sm">
						<thead>
							<tr class="border-b border-[#cfc4ba] bg-[#e0d8cf]">
								<th class="py-4 px-6 text-left font-normal text-[#6b4f47] w-1/2"></th>
								<th class="py-4 px-6 text-center font-bold text-[#1a0f0d]">Tau</th>
								<th class="py-4 px-6 text-center font-normal text-[#9b8880]">{c.name}</th>
							</tr>
						</thead>
						<tbody>
							{c.features.map((f, i) => (
								<tr class={`border-b border-[#cfc4ba] last:border-0 ${i % 2 === 0 ? 'bg-[#e8e0d8]/40' : ''}`}>
									<td class="py-3.5 px-6 text-[#1a0f0d]">{f.label}</td>
									<td class="py-3.5 px-6 text-center">
										{f.tau === true && <span class="text-[#aa1e0f] font-bold text-base">✓</span>}
										{f.tau === false && <span class="text-[#cfc4ba] font-bold text-base">✗</span>}
										{f.tau === 'partial' && <span class="text-[#9b8880] text-base">~</span>}
									</td>
									<td class="py-3.5 px-6 text-center">
										{f.them === true && <span class="text-[#6b4f47] font-bold text-base">✓</span>}
										{f.them === false && <span class="text-[#cfc4ba] font-bold text-base">✗</span>}
										{f.them === 'partial' && <span class="text-[#9b8880] text-base">~</span>}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			<!-- What each is good at -->
			<section class="mt-20 grid sm:grid-cols-2 gap-6">
				<div class="border border-[#aa1e0f] bg-[#e0d8cf] p-6">
					<p class="text-xs font-bold uppercase tracking-widest text-[#aa1e0f] mb-3">Choose Tau if</p>
					<p class="text-[#1a0f0d] text-sm leading-relaxed">{c.verdict.tau}</p>
					<a href="/#pricing" class="mt-4 inline-block text-sm font-semibold text-[#aa1e0f] hover:text-[#8a1800] transition">
						Get Tau →
					</a>
				</div>
				<div class="border border-[#cfc4ba] bg-[#e0d8cf] p-6">
					<p class="text-xs font-bold uppercase tracking-widest text-[#9b8880] mb-3">Choose {c.name} if</p>
					<p class="text-[#6b4f47] text-sm leading-relaxed">{c.verdict.them}</p>
				</div>
			</section>

			<!-- Their strengths / weaknesses -->
			<section class="mt-20 grid sm:grid-cols-2 gap-12">
				<div>
					<h2 class="text-lg font-semibold text-[#1a0f0d] mb-4">Where {c.name} excels</h2>
					<ul class="space-y-2">
						{c.theirStrengths.map((s) => (
							<li class="flex gap-3 text-sm text-[#6b4f47]">
								<span class="text-[#6b4f47] mt-0.5 shrink-0">✓</span>
								{s}
							</li>
						))}
					</ul>
				</div>
				<div>
					<h2 class="text-lg font-semibold text-[#1a0f0d] mb-4">Where {c.name} falls short for timelapse</h2>
					<ul class="space-y-2">
						{c.theirWeaknesses.map((w) => (
							<li class="flex gap-3 text-sm text-[#6b4f47]">
								<span class="text-[#aa1e0f] mt-0.5 shrink-0">✗</span>
								{w}
							</li>
						))}
					</ul>
				</div>
			</section>

			<!-- Bottom CTA -->
			<section class="mt-20 border-t border-[#cfc4ba] pt-12 text-center">
				<h2 class="text-2xl font-bold text-[#1a0f0d]">Ready to make better timelapses?</h2>
				<p class="mt-3 text-[#6b4f47]">One-time payment. Free updates. macOS and Windows.</p>
				<a href="/#pricing" class="mt-6 inline-block bg-[#aa1e0f] px-10 py-4 text-sm font-bold text-[#ede6de] hover:bg-[#8a1800] transition">
					Get Tau — from €9.99
				</a>
			</section>

			<!-- Links to other comparisons -->
			<section class="mt-16">
				<h3 class="text-sm font-semibold text-[#9b8880] uppercase tracking-widest mb-4">Other comparisons</h3>
				<div class="flex flex-wrap gap-3">
					{competitors.filter((comp) => comp.slug !== c.slug).map((comp) => (
						<a
							href={`/vs/${comp.slug}`}
							class="text-sm text-[#6b4f47] border border-[#cfc4ba] px-4 py-2 hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition"
						>
							Tau vs {comp.name}
						</a>
					))}
				</div>
			</section>

		</div>
	</main>
	<Footer />
</Layout>
