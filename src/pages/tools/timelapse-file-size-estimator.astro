---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.tsx';
import Footer from '../../components/Footer.tsx';
---

<Layout
  title="Timelapse File Size Estimator — Free Tool | Tau"
  description="Estimate the output file size of your timelapse before you record. Enter your resolution, FPS, duration, and format to get an estimated size."
  keywords={['timelapse file size', 'video file size estimator', 'mp4 file size calculator', 'gif file size', 'timelapse storage']}
>
  <Navbar client:load />

  <main class="pt-32 pb-24 px-6 min-h-screen">
    <div class="mx-auto max-w-xl">
      <a href="/blog" class="text-sm text-[#6b4f47] hover:text-[#aa1e0f] transition-colors mb-10 inline-block">
        ← Back to blog
      </a>

      <h1 class="text-4xl font-bold tracking-tight text-[#1a0f0d] mb-3">Timelapse File Size Estimator</h1>
      <p class="text-[#6b4f47] mb-10">Estimate how large your exported timelapse will be before you hit record.</p>

      <form id="calc-form" class="space-y-6">

        <div>
          <label for="resolution" class="block text-sm font-medium text-[#6b4f47] mb-2">Resolution</label>
          <div class="flex gap-2 flex-wrap mb-2">
            <button type="button" data-res="720" class="res-preset rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-2 text-sm text-[#6b4f47] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">720p</button>
            <button type="button" data-res="1080" class="res-preset rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-2 text-sm text-[#6b4f47] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">1080p</button>
            <button type="button" data-res="1440" class="res-preset rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-2 text-sm text-[#6b4f47] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">1440p</button>
            <button type="button" data-res="2160" class="res-preset rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-2 text-sm text-[#6b4f47] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">4K</button>
          </div>
          <input
            id="resolution"
            type="number"
            min="240"
            step="1"
            placeholder="e.g. 1080 (height in pixels)"
            class="w-full rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-3 text-[#1a0f0d] placeholder-[#9b8880] outline-none focus:border-[#aa1e0f] transition"
            required
          />
          <p class="text-xs text-[#9b8880] mt-1">Enter the vertical resolution (height) in pixels.</p>
        </div>

        <div>
          <label for="fps" class="block text-sm font-medium text-[#6b4f47] mb-2">Output FPS</label>
          <div class="flex gap-2 mb-2">
            <button type="button" data-fps="24" class="fps-preset rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-2 text-sm text-[#6b4f47] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">24</button>
            <button type="button" data-fps="30" class="fps-preset rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-2 text-sm text-[#6b4f47] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">30</button>
            <button type="button" data-fps="60" class="fps-preset rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-2 text-sm text-[#6b4f47] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">60</button>
          </div>
          <input
            id="fps"
            type="number"
            min="1"
            step="any"
            placeholder="e.g. 30"
            class="w-full rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-3 text-[#1a0f0d] placeholder-[#9b8880] outline-none focus:border-[#aa1e0f] transition"
            required
          />
        </div>

        <div>
          <label for="duration" class="block text-sm font-medium text-[#6b4f47] mb-2">Timelapse length (seconds)</label>
          <input
            id="duration"
            type="number"
            min="1"
            step="any"
            placeholder="e.g. 60"
            class="w-full rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-3 text-[#1a0f0d] placeholder-[#9b8880] outline-none focus:border-[#aa1e0f] transition"
            required
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-[#6b4f47] mb-2">Format</label>
          <div class="flex gap-2">
            <button type="button" data-fmt="mp4" class="fmt-preset rounded-lg border border-[#aa1e0f] bg-[#ede6de] px-4 py-2 text-sm text-[#aa1e0f] !border-[#aa1e0f] !text-[#aa1e0f] transition">MP4</button>
            <button type="button" data-fmt="webm" class="fmt-preset rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-2 text-sm text-[#6b4f47] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">WEBM</button>
            <button type="button" data-fmt="gif" class="fmt-preset rounded-lg border border-[#cfc4ba] bg-[#ede6de] px-4 py-2 text-sm text-[#6b4f47] hover:border-[#aa1e0f] hover:text-[#aa1e0f] transition">GIF</button>
          </div>
          <input type="hidden" id="format" value="mp4" />
        </div>

        <button
          type="submit"
          class="w-full bg-[#aa1e0f] px-6 py-3.5 text-base font-bold text-[#ede6de] hover:bg-[#8a1800] transition shadow-lg shadow-[#aa1e0f]/20"
        >
          Estimate size
        </button>
      </form>

      <div id="result" class="mt-8 hidden rounded-lg border border-[#cfc4ba] bg-[#e0d8cf] p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-[#9b8880] mb-4">Estimated size</p>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-[#6b4f47]">Estimated file size</span>
            <span id="out-size" class="text-2xl font-bold text-[#aa1e0f] tabular-nums"></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-[#6b4f47]">Format</span>
            <span id="out-format" class="text-lg font-semibold text-[#1a0f0d]"></span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-[#6b4f47]">Total frames</span>
            <span id="out-frames" class="text-lg font-semibold text-[#1a0f0d] tabular-nums"></span>
          </div>
        </div>
        <p class="text-xs text-[#9b8880] mt-4">Estimates are approximate. Actual size varies with content complexity and encoder quality settings.</p>
      </div>

      <div class="mt-12 space-y-4 text-sm text-[#6b4f47]">
        <h2 class="text-base font-semibold text-[#1a0f0d]">Why file size varies</h2>
        <p>
          Video codecs like H.264 (MP4) and VP9 (WEBM) compress frames based on how much changes between them. A timelapse of a static scene will be smaller than one with lots of motion. GIF files are generally larger per-frame but work anywhere.
        </p>
        <p>
          Use MP4 for the best compression and broad compatibility. Use WEBM if you're embedding on a website. Use GIF only when you need autoplay without a video player.
        </p>
      </div>

      <p class="mt-12 text-sm text-[#9b8880] text-center">
        Built by <a href="https://www.trytau.app" class="text-[#aa1e0f] hover:text-[#8a1800] transition underline underline-offset-4">Tau</a> — export your timelapse to MP4, GIF, or WEBM with one click.
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('calc-form') as HTMLFormElement;
  const resInput = document.getElementById('resolution') as HTMLInputElement;
  const fpsInput = document.getElementById('fps') as HTMLInputElement;
  const durationInput = document.getElementById('duration') as HTMLInputElement;
  const formatInput = document.getElementById('format') as HTMLInputElement;
  const resultDiv = document.getElementById('result') as HTMLElement;
  const outSize = document.getElementById('out-size') as HTMLElement;
  const outFormat = document.getElementById('out-format') as HTMLElement;
  const outFrames = document.getElementById('out-frames') as HTMLElement;

  // Approximate bitrates in kbps per pixel row at 30fps
  const BITRATES: Record<string, Record<number, number>> = {
    mp4:  { 720: 2500,  1080: 5000,  1440: 10000, 2160: 20000 },
    webm: { 720: 1800,  1080: 3500,  1440: 7000,  2160: 14000 },
    gif:  { 720: 8000,  1080: 16000, 1440: 28000, 2160: 50000 },
  };

  function getBitrate(fmt: string, res: number): number {
    const table = BITRATES[fmt];
    const keys = Object.keys(table).map(Number).sort((a, b) => a - b);
    // Find nearest resolution bracket
    let closest = keys[0];
    for (const k of keys) {
      if (res >= k) closest = k;
    }
    // Scale proportionally above the highest bracket
    const scale = res / closest;
    return Math.round(table[closest] * scale);
  }

  function formatBytes(bytes: number): string {
    if (bytes >= 1_000_000_000) return `${(bytes / 1_000_000_000).toFixed(1)} GB`;
    if (bytes >= 1_000_000) return `${(bytes / 1_000_000).toFixed(1)} MB`;
    return `${(bytes / 1_000).toFixed(0)} KB`;
  }

  function activatePreset(group: string, attr: string, value: string, hiddenId?: string) {
    document.querySelectorAll(`.${group}`).forEach((b) => {
      b.classList.remove('!border-[#aa1e0f]', '!text-[#aa1e0f]');
    });
    const btn = document.querySelector(`.${group}[data-${attr}="${value}"]`);
    btn?.classList.add('!border-[#aa1e0f]', '!text-[#aa1e0f]');
    if (hiddenId) (document.getElementById(hiddenId) as HTMLInputElement).value = value;
  }

  document.querySelectorAll<HTMLButtonElement>('.res-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      activatePreset('res-preset', 'res', btn.dataset.res!);
      resInput.value = btn.dataset.res!;
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.fps-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      activatePreset('fps-preset', 'fps', btn.dataset.fps!);
      fpsInput.value = btn.dataset.fps!;
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.fmt-preset').forEach((btn) => {
    btn.addEventListener('click', () => activatePreset('fmt-preset', 'fmt', btn.dataset.fmt!, 'format'));
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const res = parseFloat(resInput.value);
    const fps = parseFloat(fpsInput.value);
    const duration = parseFloat(durationInput.value);
    const fmt = formatInput.value;

    if (isNaN(res) || isNaN(fps) || isNaN(duration)) return;

    const bitrate = getBitrate(fmt, res);
    const totalFrames = Math.round(fps * duration);
    const sizeBytes = (bitrate * 1000 / 8) * duration;

    outSize.textContent = formatBytes(sizeBytes);
    outFormat.textContent = fmt.toUpperCase();
    outFrames.textContent = totalFrames.toLocaleString();
    resultDiv.classList.remove('hidden');
  });
</script>
